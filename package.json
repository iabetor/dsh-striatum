{
  "name": "dsh-striatum",
  "version": "0.1.0",
  "description": "The DeepSeek Harness changes gatekeeper: every file change an agent makes passes through your striatum — keep it, undo it, or leave it pending. Named after the striatum, the brain's action gatekeeper.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "changes",
    "gatekeeper",
    "striatum"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "diff": "^9.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-fs": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.6-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
